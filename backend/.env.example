# Node
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://forge_user:forge_pass@localhost:5432/forge_dev?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars_long_12345678901234567890
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars_long_1234567890123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=debug

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Test Database (used when NODE_ENV=test)
TEST_DATABASE_URL="postgresql://forge_user:forge_pass@localhost:5432/forge_test?schema=public"
